# =========================================================
# 环境变量配置说明
# =========================================================
# 运行服务前，请先复制本文件为 .env。
#
# Windows PowerShell:
# Copy-Item .env.example .env
#
# Linux / macOS:
# cp .env.example .env
#
# 然后编辑 .env，把占位符替换为自己的 API Key、模型地址、
# 后端地址和本地存储路径。
#
#不想在命令行操作的可以自己手动复制 .env.example(留备份) 粘贴改名 .env
#也可以直接把 .env.example 改名 .env

# 聊天模型配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

# Embedding 模型配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# LangSmith 监控，可选
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=douyin-spark-assistant

# douyin-spark Go 后端地址
DOUYIN_SPARK_API_BASE_URL=http://localhost:8787/api/v1

# 知识库和向量库路径
KNOWLEDGE_DIR=./knowledge/user
CHROMA_PERSIST_DIR=./storage/vectorstore
ASSISTANT_CHECKPOINT_DB_PATH=./storage/assistant_checkpoints.sqlite

# 上下文压缩配置
ASSISTANT_CONTEXT_MAX_INPUT_TOKENS=12000
ASSISTANT_SUMMARY_TRIGGER_FRACTION=0.75
ASSISTANT_SUMMARY_KEEP_FRACTION=0.40
